# ==============================================================================
# DISCORD VC COUNTER BOT & REAL-TIME WEB DASHBOARD - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your real configuration:
#   cp .env.example .env
#
# IMPORTANT SECURITY WARNING:
# NEVER commit your actual .env file or your Discord bot token to public version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DISCORD BOT CREDENTIALS
# ------------------------------------------------------------------------------
# Obtain your Bot Token from Discord Developer Portal:
# https://discord.com/developers/applications -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=your_discord_bot_token_here

# Your Application ID (Client ID) from General Information tab:
DISCORD_CLIENT_ID=your_discord_client_id_here

# Bot command prefix for legacy prefix commands (e.g. !stats, !setup)
BOT_PREFIX=!

# ------------------------------------------------------------------------------
# 2. FASTAPI & WEB SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Host interface to bind to (0.0.0.0 binds to all network interfaces for Docker/VPS)
HOST=0.0.0.0

# Port for the web dashboard and REST/WebSocket API
PORT=8000

# Public-facing dashboard base URL (used in /dashboard command and link generation)
# For local development: http://localhost:8000
# For production VPS with domain: https://vc.yourdomain.com
DASHBOARD_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Strong dashboard administrator secret key.
# Used to authenticate administrative dashboard access, configuration updates,
# and private dashboard views. Generate a secure 32+ character random string:
# Run: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_SECRET=generate_a_secure_random_token_here_32_chars_or_more

# Global dashboard mode default for newly joined guilds:
#   false = Private by default (requires admin token / login)
#   true  = Public read-only by default (anyone with the URL can view voice stats)
DEFAULT_PUBLIC_DASHBOARD=false

# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGINS=*

# API Rate limiting (requests per minute per IP for sensitive endpoints)
RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 4. DISCORD COUNTER CHANNELS SETTINGS
# ------------------------------------------------------------------------------
# Discord enforces a strict rate limit on channel name edits:
# MAX 2 renames per 10 minutes per channel!
# Setting this too low will result in Discord 429 Rate Limit errors.
# Recommended: 300 (5 minutes) or 600 (10 minutes)
COUNTER_UPDATE_INTERVAL_SECONDS=300

# ------------------------------------------------------------------------------
# 5. STORAGE & DATABASE
# ------------------------------------------------------------------------------
# SQLite database file path (persisted across restarts)
DATABASE_PATH=data/bot.db

# ------------------------------------------------------------------------------
# 6. RUNTIME & LOGGING
# ------------------------------------------------------------------------------
# Runtime environment: 'development' or 'production'
ENVIRONMENT=production

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
